model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setups Setup[]

  @@index([isActive, order])
  @@map("categories")
}
