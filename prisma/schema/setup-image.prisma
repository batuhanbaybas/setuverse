model SetupImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setupId String
  setup   Setup  @relation(fields: [setupId], references: [id], onDelete: Cascade)

  pins EquipmentPin[]

  @@index([setupId])
  @@index([setupId, order])
  @@map("setup_images")
}
